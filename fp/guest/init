#!/bin/sh
export PATH=/bin:/sbin TERM=xterm
exec </dev/console >/dev/console 2>&1
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /tmp
fail() { echo "FP_FAIL: $*"; sync; reboot -f; while :; do sleep 1; done; }
run() { printf 'fp-guest:/#'; printf ' %s' "$@"; printf '\n'; "$@" || fail "$*"; }
screen() { printf '\033[2J\033[H'; echo "=== FP / $* / Linux $(uname -r) ==="; echo; }
pause() { echo; echo "$1"; sleep 5; }
dir=/proc/procfs_example

screen 'Option 1 / compatible kernel and module load'
run uname -a
run cat /proc/version
run insmod /lib/modules/procfs_example.ko
run lsmod
run ls -l "$dir"
echo
echo 'The original create_proc_entry/read_proc/write_proc interfaces are available here.'
echo 'This is the compatible-kernel route; the openEuler feature study follows separately.'
pause FP_LOAD_OK

screen 'Read callbacks / per-file private data / jiffies'
run cat "$dir/foo" "$dir/bar"
[ "$(cat "$dir/foo")" = "foo = 'foo'" ] || fail initial_foo
[ "$(cat "$dir/bar")" = "bar = 'bar'" ] || fail initial_bar
t1=$(awk '{print $3}' "$dir/jiffies")
run cat "$dir/jiffies"
sleep 1
t2=$(awk '{print $3}' "$dir/jiffies")
run cat "$dir/jiffies"
echo "Measured tick samples: before=$t1 after=$t2 delta=$((t2-t1))"
[ "$t2" -gt "$t1" ] || fail ticks_not_advancing
echo 'PASS: foo/bar use the same read callback and different data pointers.'
echo 'PASS: jiffies is generated by the kernel callback and advances with time.'
pause FP_READ_OK

screen 'Write callbacks / independent state'
run sh -c 'printf Linux > /proc/procfs_example/foo'
run sh -c 'printf Euler > /proc/procfs_example/bar'
run cat "$dir/foo" "$dir/bar"
[ "$(cat "$dir/foo")" = "foo = 'Linux'" ] || fail write_foo
[ "$(cat "$dir/bar")" = "bar = 'Euler'" ] || fail write_bar
run sh -c 'dmesg | grep "shared write callback"'
echo 'PASS: userspace write -> copy_from_user -> kernel state -> read callback.'
echo 'The same callback selects foo or bar through the proc entry data pointer.'
pause FP_WRITE_OK

screen 'Debug fixes / 8-byte boundary and offset/EOF reads'
run sh -c 'printf 12345678 > /proc/procfs_example/foo'
run cat "$dir/foo"
echo 'fp-guest:/# printf 123456789 > /proc/procfs_example/foo'
if printf 123456789 > "$dir/foo"; then fail overlong_write_accepted; else echo 'Expected: 9-byte write rejected with E2BIG.'; fi
[ "$(cat "$dir/foo")" = "foo = '12345678'" ] || fail rejected_write_changed_value
run sh -c 'dd if=/proc/procfs_example/foo of=/tmp/byte_reads bs=1 2>/tmp/dd.log'
run cat /tmp/byte_reads
run cat /tmp/dd.log
[ "$(cat /tmp/byte_reads)" = "foo = '12345678'" ] || fail byte_reads
echo 'PASS: exact limit accepted; overlong input leaves previous value unchanged.'
echo 'PASS: one-byte reads terminate at EOF and reconstruct the complete string.'
pause FP_BOUNDARY_OK

screen 'Directory, symlink and file permissions'
run ls -ld "$dir"
run ls -l "$dir"
run readlink "$dir/jiffies_too"
[ "$(readlink "$dir/jiffies_too")" = jiffies ] || fail symlink_target
run cat "$dir/jiffies_too"
echo 'PASS: relative symlink resolves to the generated jiffies entry.'
echo 'foo/bar mode 0644: owner read/write; group and others read.'
echo 'jiffies mode 0444: read-only interface. /proc data is generated in memory.'
pause FP_LINK_OK

screen 'Unload, complete cleanup and fresh reload'
run rmmod procfs_example
[ ! -e "$dir" ] || fail directory_leaked
echo 'PASS: directory, files and symlink removed.'
run insmod /lib/modules/procfs_example.ko
run cat "$dir/foo" "$dir/bar"
[ "$(cat "$dir/foo")" = "foo = 'foo'" ] || fail reload_foo
[ "$(cat "$dir/bar")" = "bar = 'bar'" ] || fail reload_bar
run rmmod procfs_example
run lsmod
run sh -c 'dmesg | grep "procfs_example:" | tail -n 6'
echo 'PASS: reload restores initial values; final unload leaves no procfs entries.'
pause FP_CLEANUP_OK
echo FP_GUEST_SUCCESS
sync
reboot -f
while :; do sleep 1; done
